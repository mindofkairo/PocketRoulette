<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <RootNamespace>PocketRoulette</RootNamespace>
        <AssemblyName>PocketRoulette</AssemblyName>
        <LangVersion>latest</LangVersion>
        <Version>1.3.0</Version>
        <OutputPath>build/</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>

    <PropertyGroup>
        <RefsPath Condition="'$(RefsPath)' == ''">../../References</RefsPath>
        <GameManagedPath Condition="'$(GamePath)' != '' And Exists('$(GamePath)/EscapeFromTarkov_Data/Managed/Assembly-CSharp.dll')">$(GamePath)/EscapeFromTarkov_Data/Managed</GameManagedPath>
        <GameManagedPath Condition="'$(GameManagedPath)' == '' And '$(GamePath)' != '' And Exists('$(GamePath)/SPT_Runtime/Assembly-CSharp.dll')">$(GamePath)/SPT_Runtime</GameManagedPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="BepInEx">
            <HintPath Condition="'$(GamePath)' != '' And Exists('$(GamePath)/BepInEx/core/BepInEx.dll')">$(GamePath)/BepInEx/core/BepInEx.dll</HintPath>
            <HintPath Condition="('$(GamePath)' == '' Or !Exists('$(GamePath)/BepInEx/core/BepInEx.dll')) And Exists('$(RefsPath)/BepInEx.dll')">$(RefsPath)/BepInEx.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath Condition="'$(GamePath)' != '' And Exists('$(GamePath)/BepInEx/core/0Harmony.dll')">$(GamePath)/BepInEx/core/0Harmony.dll</HintPath>
            <HintPath Condition="('$(GamePath)' == '' Or !Exists('$(GamePath)/BepInEx/core/0Harmony.dll')) And Exists('$(RefsPath)/0Harmony.dll')">$(RefsPath)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="BepInEx.Harmony">
            <HintPath Condition="'$(GamePath)' != '' And Exists('$(GamePath)/BepInEx/core/BepInEx.Harmony.dll')">$(GamePath)/BepInEx/core/BepInEx.Harmony.dll</HintPath>
            <HintPath Condition="('$(GamePath)' == '' Or !Exists('$(GamePath)/BepInEx/core/BepInEx.Harmony.dll')) And Exists('$(RefsPath)/BepInEx.Harmony.dll')">$(RefsPath)/BepInEx.Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="spt-common">
            <HintPath Condition="'$(GamePath)' != '' And Exists('$(GamePath)/BepInEx/plugins/spt/spt-common.dll')">$(GamePath)/BepInEx/plugins/spt/spt-common.dll</HintPath>
            <HintPath Condition="('$(GamePath)' == '' Or !Exists('$(GamePath)/BepInEx/plugins/spt/spt-common.dll')) And Exists('$(RefsPath)/spt-common.dll')">$(RefsPath)/spt-common.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="spt-reflection">
            <HintPath Condition="'$(GamePath)' != '' And Exists('$(GamePath)/BepInEx/plugins/spt/spt-reflection.dll')">$(GamePath)/BepInEx/plugins/spt/spt-reflection.dll</HintPath>
            <HintPath Condition="('$(GamePath)' == '' Or !Exists('$(GamePath)/BepInEx/plugins/spt/spt-reflection.dll')) And Exists('$(RefsPath)/spt-reflection.dll')">$(RefsPath)/spt-reflection.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="Assembly-CSharp">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/Assembly-CSharp.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="ItemTemplate.Types">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/ItemTemplate.Types.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/ItemTemplate.Types.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="DissonanceVoip">
            <HintPath>$(RefsPath)/DissonanceVoip.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp-firstpass">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/Assembly-CSharp-firstpass.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/Assembly-CSharp-firstpass.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Comfort">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/Comfort.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/Comfort.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Comfort.Unity">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/Comfort.Unity.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/Comfort.Unity.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/Newtonsoft.Json.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/Newtonsoft.Json.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="ItemComponent.Types">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/ItemComponent.Types.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/ItemComponent.Types.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityEngine">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/UnityEngine.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/UnityEngine.CoreModule.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.GridModule">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/UnityEngine.GridModule.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/UnityEngine.GridModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.PhysicsModule">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/UnityEngine.PhysicsModule.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/UnityEngine.PhysicsModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="FikaBridge.cs" />
    </ItemGroup>

    <PropertyGroup>
        <GamePath Condition="'$(GamePath)' == ''"></GamePath>
        <PluginPath Condition="'$(PluginPath)' == ''">$(GamePath)/BepInEx/plugins/PocketRoulette</PluginPath>
    </PropertyGroup>

    <Target Name="CopyToGame" AfterTargets="AfterBuild" Condition="'$(GamePath)' != '' And Exists('$(GamePath)')">
        <Message Importance="high" Text="Copying client plugin to $(PluginPath)" />
        <ItemGroup>
            <PluginFiles Include="$(OutputPath)$(TargetName)$(TargetExt)" />
            <PluginFiles Include="$(OutputPath)$(TargetName).pdb" Condition="Exists('$(OutputPath)$(TargetName).pdb')" />
        </ItemGroup>
        <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginPath)" ContinueOnError="false" />
        <Delete Files="$(PluginPath)/PocketRoulette.Fika.dll" Condition="!Exists('$(GamePath)/BepInEx/plugins/Fika/Fika.Core.dll')" />
        <Delete Files="$(PluginPath)/PocketRoulette.Fika.pdb" Condition="!Exists('$(GamePath)/BepInEx/plugins/Fika/Fika.Core.dll')" />
        <Message Text="Client plugin copied successfully." Importance="high" />
    </Target>
</Project>
