<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <RootNamespace>PocketRoulette</RootNamespace>
        <AssemblyName>PocketRoulette.Fika</AssemblyName>
        <LangVersion>latest</LangVersion>
        <Version>1.9.2</Version>
        <OutputPath>build/</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <PropertyGroup>
        <RefsPath Condition="'$(RefsPath)' == ''">../../References</RefsPath>
        <GameManagedPath Condition="'$(GamePath)' != '' And Exists('$(GamePath)/EscapeFromTarkov_Data/Managed/Assembly-CSharp.dll')">$(GamePath)/EscapeFromTarkov_Data/Managed</GameManagedPath>
        <GameManagedPath Condition="'$(GameManagedPath)' == '' And '$(GamePath)' != '' And Exists('$(GamePath)/SPT_Runtime/Assembly-CSharp.dll')">$(GamePath)/SPT_Runtime</GameManagedPath>
        <GamePath Condition="'$(GamePath)' == ''"></GamePath>
        <PluginPath Condition="'$(PluginPath)' == ''">$(GamePath)/BepInEx/plugins/PocketRoulette</PluginPath>
        <FikaAssemblyPath Condition="'$(FikaAssemblyPath)' == '' And '$(GamePath)' != '' And Exists('$(GamePath)/BepInEx/plugins/Fika/Fika.Core.dll')">$(GamePath)/BepInEx/plugins/Fika/Fika.Core.dll</FikaAssemblyPath>
        <FikaAssemblyPath Condition="'$(FikaAssemblyPath)' == '' And Exists('$(RefsPath)/Fika.Core.dll')">$(RefsPath)/Fika.Core.dll</FikaAssemblyPath>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../PocketRoulette/FikaBridge.cs" Link="FikaBridge.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../PocketRoulette/PocketRoulette.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="BepInEx">
            <HintPath Condition="'$(GamePath)' != '' And Exists('$(GamePath)/BepInEx/core/BepInEx.dll')">$(GamePath)/BepInEx/core/BepInEx.dll</HintPath>
            <HintPath Condition="('$(GamePath)' == '' Or !Exists('$(GamePath)/BepInEx/core/BepInEx.dll')) And Exists('$(RefsPath)/BepInEx.dll')">$(RefsPath)/BepInEx.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/Assembly-CSharp.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Comfort">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/Comfort.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/Comfort.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="DissonanceVoip">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/DissonanceVoip.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/DissonanceVoip.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Fika.Core">
            <HintPath>$(FikaAssemblyPath)</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/UnityEngine.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath Condition="'$(GameManagedPath)' != ''">$(GameManagedPath)/UnityEngine.CoreModule.dll</HintPath>
            <HintPath Condition="'$(GameManagedPath)' == ''">$(RefsPath)/UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="CopyToGame" AfterTargets="AfterBuild" Condition="'$(DeployToGame)' != 'false' And '$(GamePath)' != '' And Exists('$(GamePath)/BepInEx/plugins/Fika/Fika.Core.dll')">
        <ItemGroup>
            <PluginFiles Include="$(OutputPath)$(TargetName)$(TargetExt)" />
            <PluginFiles Include="$(OutputPath)$(TargetName).pdb" Condition="Exists('$(OutputPath)$(TargetName).pdb')" />
        </ItemGroup>
        <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginPath)" ContinueOnError="false" />
    </Target>
</Project>

