<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>PocketRoulette.Server</RootNamespace>
        <AssemblyName>PocketRoulette.Server</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <Version>1.2.0</Version>
        <OutputPath>build/</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SPTarkov.Common" Version="4.0.3" />
        <PackageReference Include="SPTarkov.DI" Version="4.0.3" />
        <PackageReference Include="SPTarkov.Server.Core" Version="4.0.3" />
    </ItemGroup>

    <PropertyGroup>
        <SPTPath Condition="'$(SPTPath)' == ''"></SPTPath>
        <ModsDirectoryPath Condition="'$(ModsDirectoryPath)' == ''">$(SPTPath)/user/mods/PocketRoulette</ModsDirectoryPath>
    </PropertyGroup>

    <Target Name="CopyToSPT" AfterTargets="AfterBuild" Condition="'$(SPTPath)' != '' And Exists('$(SPTPath)')">
        <Message Importance="high" Text="Copying server mod files to $(ModsDirectoryPath)" />

        <ItemGroup>
            <FilesToCopy Include="$(OutputPath)$(TargetName)$(TargetExt)" />
            <FilesToCopy Include="$(OutputPath)$(TargetName).pdb" Condition="Exists('$(OutputPath)$(TargetName).pdb')" />
        </ItemGroup>
        <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(ModsDirectoryPath)" ContinueOnError="false" />

        <Message Text="Server mod files copied successfully." Importance="high" />
    </Target>
</Project>
