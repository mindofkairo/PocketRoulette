<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>PocketRoulette.Server</RootNamespace>
        <AssemblyName>PocketRoulette.Server</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <Version>1.9.3</Version>
        <SptVersion>~4.1.0</SptVersion>
        <OutputPath>build/</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <DefineConstants>$(DefineConstants);SERVER_JSON</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
        <EmbeddedResource Include="config/config.jsonc" LogicalName="PocketRoulette.DefaultConfig.json" />
        <PackageReference Include="SPTarkov.Common" Version="4.1.0" />
        <PackageReference Include="SPTarkov.DI" Version="4.1.0" />
        <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" />
    </ItemGroup>

    <PropertyGroup>
        <SPTPath Condition="'$(SPTPath)' == ''"></SPTPath>
        <ModsDirectoryPath Condition="'$(ModsDirectoryPath)' == '' And Exists('$(SPTPath)/SPT_Runtime/user/mods')">$(SPTPath)/SPT_Runtime/user/mods/PocketRoulette</ModsDirectoryPath>
        <ModsDirectoryPath Condition="'$(ModsDirectoryPath)' == ''">$(SPTPath)/user/mods/PocketRoulette</ModsDirectoryPath>
    </PropertyGroup>

    <Target Name="CopyToSPT" AfterTargets="AfterBuild" Condition="'$(SPTPath)' != '' And Exists('$(SPTPath)')">
        <Message Importance="high" Text="Copying server mod files to $(ModsDirectoryPath)" />

        <ItemGroup>
            <FilesToCopy Include="$(OutputPath)$(TargetName)$(TargetExt)" />
            <FilesToCopy Include="$(OutputPath)$(TargetName).pdb" Condition="Exists('$(OutputPath)$(TargetName).pdb')" />
        </ItemGroup>
        <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(ModsDirectoryPath)" ContinueOnError="false" />

        <Message Text="Server mod files copied successfully." Importance="high" />
    </Target>
</Project>


